# Every visible immediate subdirectory of base_dir is discovered automatically.
# No [[app]] section is required for applications that follow the conventions.

[global]
base_dir = "/home/abc/processguard/apps"
startup_validation_secs = 10
stop_grace_secs = 30
timeout_secs = 30
guard_log = "guard.log"

[global.log]
stdout = "logs/stdout.log"
stderr = "logs/stderr.log"
max_size = "15MiB"
max_keep = 10
compress_after = 3
compression = "gzip"

# Add a section only when an application needs an override.
#
# [[app]]
# name = "api"
# healthcheck = "./healthcheck.sh"
# startup_validation_secs = 20
#
# [app.log]
# max_keep = 5
#
# [[app]]
# name = "manually-managed"
# managed = false
